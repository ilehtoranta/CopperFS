<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(CopperFsAutoTrim)' == 'true'">$(DefineConstants);COPPERFS_AUTOTRIM</DefineConstants>
    <!-- Empty keeps the shared source consumer and host tests multi-format. -->
    <DefineConstants Condition="'$(CopperFsHandler)' == 'Ffs'">$(DefineConstants);COPPERSTART_FFS_ONLY;COPPERFS_FFS_HANDLER</DefineConstants>
    <DefineConstants Condition="'$(CopperFsHandler)' == 'Sfs'">$(DefineConstants);COPPERSTART_SFS_ONLY;COPPERSTART_SMART_ONLY</DefineConstants>
    <CopperStartSfsTrstWrites Condition="'$(CopperStartSfsTrstWrites)' == ''">true</CopperStartSfsTrstWrites>
    <CopperStartSfs2TrstWrites Condition="'$(CopperStartNativeSfs2)' == 'true' and '$(CopperStartSfs2TrstWrites)' == ''">true</CopperStartSfs2TrstWrites>
    <CopperStartSfsTrstBuffered Condition="'$(CopperStartSfsTrstBuffered)' == '' and '$(CopperStartSfsTrstWrites)' == 'true' and '$(CopperStartSfsStrictWrites)' != 'true' and '$(CopperStartNativeSfs2)' != 'true'">true</CopperStartSfsTrstBuffered>
    <DefineConstants>$(DefineConstants);COPPERSTART_SFS_STANDALONE;COPPERSTART_NATIVE_SFS_WRITES</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfsStrictWrites)' == 'true'">$(DefineConstants);COPPERSTART_SFS_STRICT_WRITES</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfsTrstWrites)' == 'true'">$(DefineConstants);COPPERSTART_SFS_TRST_WRITES</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfsTrstBuffered)' == 'true'">$(DefineConstants);COPPERSTART_SFS_TRST_BUFFERED</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfs2TrstWrites)' == 'true'">$(DefineConstants);COPPERSTART_SFS2_TRST_WRITES</DefineConstants>
    <DefineConstants Condition="'$(CopperStartNativeSfs2)' == 'true'">$(DefineConstants);COPPERSTART_NATIVE_SFS2</DefineConstants>
    <DefineConstants Condition="'$(CopperFsNativeFfsReadAhead)' == 'true'">$(DefineConstants);COPPERFS_NATIVE_FFS_READAHEAD</DefineConstants>
    <DefineConstants Condition="'$(CopperFsFfsOnly)' == 'true'">$(DefineConstants);COPPERSTART_FFS_ONLY;COPPERFS_FFS_HANDLER</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSmartOnly)' == 'true'">$(DefineConstants);COPPERSTART_SMART_ONLY</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateHandlerFamily" BeforeTargets="BeforeBuild">
    <Error Condition="'$(CopperFsHandler)' != '' and '$(CopperFsHandler)' != 'Ffs' and '$(CopperFsHandler)' != 'Sfs'"
           Text="CopperFsHandler must be empty, Ffs or Sfs." />
  </Target>
  <Target Name="ValidateStandaloneProfile" BeforeTargets="BeforeBuild"
          Condition="'$(CopperStartSfsTrstBuffered)' == 'true'">
    <Error Condition="'$(CopperStartSfsTrstWrites)' != 'true' or '$(CopperStartSfsStrictWrites)' == 'true' or '$(CopperStartNativeSfs2)' == 'true'"
           Text="Buffered TRST requires a classic TRST handler without strict writes." />
  </Target>
  <Target Name="ValidateFfsOnlyProfile" BeforeTargets="BeforeBuild" Condition="'$(CopperFsFfsOnly)' == 'true' and '$(CopperStartNativeSfs2)' == 'true'">
    <Error Text="CopperFsFfsOnly cannot be combined with CopperStartNativeSfs2." />
  </Target>
  <Target Name="ValidateSmartOnlyProfile" BeforeTargets="BeforeBuild" Condition="'$(CopperFsSmartOnly)' == 'true' and '$(CopperFsFfsOnly)' == 'true'">
    <Error Text="CopperFsSmartOnly cannot be combined with CopperFsFfsOnly." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="CopperFS.Kickstart.Tests" />
    <ProjectReference Include="../CopperSFS.Core/CopperSFS.Core.csproj" />
    <Using Include="CopperSFS" />
  </ItemGroup>
  <Import Project="../../build/CopperFFS.Sources.props" />
</Project>
