<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(CopperFsHandler)' == 'Cpx4'">$(DefineConstants);COPPERFS_CPX4</DefineConstants>
    <DefineConstants Condition="'$(CopperFsAutoTrim)' == 'true'">$(DefineConstants);COPPERFS_AUTOTRIM</DefineConstants>
    <DefineConstants Condition="'$(CopperFsFfsOnly)' == 'true' and '$(CopperFsFfsTrimLayoutControl)' == 'true'">$(DefineConstants);COPPERFS_AUTOTRIM;COPPERFS_FFS_TRIM_LAYOUT_CONTROL</DefineConstants>
    <DefineConstants Condition="'$(CopperFsFfsOnly)' == 'true' and '$(CopperFsFfsTrimLayoutControl)' == 'true' and '$(CopperFsAutoTrim)' != 'true'">$(DefineConstants);COPPERFS_FFS_TRIM_POLICY_OFF</DefineConstants>
    <DefineConstants Condition="'$(CopperFsFfsIndexKiB)' == '64'">$(DefineConstants);COPPERFS_FFS_INDEX64</DefineConstants>
    <DefineConstants Condition="'$(CopperFsFfsIndexKiB)' == '1024'">$(DefineConstants);COPPERFS_FFS_INDEX1024</DefineConstants>
    <!-- Empty keeps the shared source consumer and host tests multi-format. -->
    <CopperFsFfsOnly Condition="'$(CopperFsHandler)' == 'Ffs'">true</CopperFsFfsOnly>
    <CopperFsSmartOnly Condition="'$(CopperFsHandler)' == 'Sfs'">true</CopperFsSmartOnly>
    <DefineConstants Condition="'$(CopperFsHandler)' == 'Ffs'">$(DefineConstants);COPPERSTART_FFS_ONLY;COPPERFS_FFS_HANDLER</DefineConstants>
    <DefineConstants Condition="'$(CopperFsHandler)' == 'Sfs'">$(DefineConstants);COPPERSTART_SFS_ONLY;COPPERSTART_SMART_ONLY</DefineConstants>
    <CopperStartSfsTrstWrites Condition="'$(CopperStartSfsTrstWrites)' == ''">true</CopperStartSfsTrstWrites>
    <CopperStartSfs2TrstWrites Condition="'$(CopperStartNativeSfs2)' == 'true' and '$(CopperStartSfs2TrstWrites)' == ''">true</CopperStartSfs2TrstWrites>
    <CopperStartSfsTrstBuffered Condition="'$(CopperStartSfsTrstBuffered)' == '' and '$(CopperStartSfsTrstWrites)' == 'true' and '$(CopperStartSfsStrictWrites)' != 'true' and '$(CopperStartNativeSfs2)' != 'true'">true</CopperStartSfsTrstBuffered>
    <DefineConstants>$(DefineConstants);COPPERSTART_SFS_STANDALONE;COPPERSTART_NATIVE_SFS_WRITES</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfsStrictWrites)' == 'true'">$(DefineConstants);COPPERSTART_SFS_STRICT_WRITES</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfsTrstWrites)' == 'true'">$(DefineConstants);COPPERSTART_SFS_TRST_WRITES</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfsTrstBuffered)' == 'true'">$(DefineConstants);COPPERSTART_SFS_TRST_BUFFERED</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSfsPool)' == 'true'">$(DefineConstants);COPPERFS_SFS_POOL</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSfsPool)' == 'true' and '$(CopperFsSfsInPlace)' == 'true'">$(DefineConstants);COPPERFS_SFS_IN_PLACE</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSfsPool)' == 'true' and '$(CopperFsSfsExtraKiB)' == '16'">$(DefineConstants);COPPERFS_SFS_EXTRA_CACHE</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSfsGrouped)' == 'true'">$(DefineConstants);COPPERFS_SFS_GROUPED</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfs2TrstGrouped)' == 'true'">$(DefineConstants);COPPERSTART_SFS2_TRST_GROUPED</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSfs2Owned)' == 'true'">$(DefineConstants);COPPERFS_SFS2_OWNED</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSfs2ExtraKiB)' == '16'">$(DefineConstants);COPPERFS_SFS2_EXTRA16</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSfs2ExtraKiB)' == '64'">$(DefineConstants);COPPERFS_SFS2_EXTRA64</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSfs2ExtraKiB)' == '256'">$(DefineConstants);COPPERFS_SFS2_EXTRA256</DefineConstants>
    <DefineConstants Condition="'$(CopperStartSfs2TrstWrites)' == 'true'">$(DefineConstants);COPPERSTART_SFS2_TRST_WRITES</DefineConstants>
    <DefineConstants Condition="'$(CopperStartNativeSfs2)' == 'true'">$(DefineConstants);COPPERSTART_NATIVE_SFS2</DefineConstants>
    <DefineConstants Condition="'$(CopperFsNativeFfsReadAhead)' == 'true'">$(DefineConstants);COPPERFS_NATIVE_FFS_READAHEAD</DefineConstants>
    <DefineConstants Condition="'$(CopperFsFfsOnly)' == 'true'">$(DefineConstants);COPPERSTART_FFS_ONLY;COPPERFS_FFS_HANDLER</DefineConstants>
    <DefineConstants Condition="'$(CopperFsSmartOnly)' == 'true'">$(DefineConstants);COPPERSTART_SMART_ONLY</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateHandlerFamily" BeforeTargets="BeforeBuild">
    <Error Condition="'$(CopperFsHandler)' != '' and '$(CopperFsHandler)' != 'Ffs' and '$(CopperFsHandler)' != 'Sfs' and '$(CopperFsHandler)' != 'Cpx4'"
           Text="CopperFsHandler must be empty, Ffs, Sfs or Cpx4 (experimental handler)." />
  </Target>
  <Target Name="ValidateSfs2GroupedProfile" BeforeTargets="BeforeBuild" Condition="'$(CopperStartSfs2TrstGrouped)' == 'true'">
    <Error Condition="'$(CopperStartNativeSfs2)' != 'true' or '$(CopperStartSfs2TrstWrites)' != 'true' or '$(CopperStartSfsStrictWrites)' == 'true'"
           Text="Grouped SFS2 requires SFS2 TRST without strict writes." />
  </Target>
  <Target Name="ValidateSfsGroupedProfile" BeforeTargets="BeforeBuild" Condition="'$(CopperFsSfsGrouped)' == 'true'">
    <Error Condition="'$(CopperStartSfsTrstBuffered)' != 'true' or '$(CopperFsFfsOnly)' == 'true'" Text="Grouped SFS requires the buffered SFS TRST profile." />
  </Target>
  <Target Name="ValidateSfsPoolProfile" BeforeTargets="BeforeBuild" Condition="'$(CopperFsSfsPool)' == 'true'">
    <Error Condition="'$(CopperFsSfsGrouped)' != 'true'" Text="Shared SFS images require the opt-in grouped SFS profile." />
  </Target>
  <Target Name="ValidateSfs2OwnedProfile" BeforeTargets="BeforeBuild" Condition="'$(CopperFsSfs2Owned)' == 'true'">
    <Error Condition="'$(CopperStartSfs2TrstGrouped)' != 'true'" Text="Owned SFS2 requires grouped SFS2 TRST." />
    <Error Condition="'$(CopperFsSfs2ExtraKiB)' != '' and '$(CopperFsSfs2ExtraKiB)' != '0' and '$(CopperFsSfs2ExtraKiB)' != '16' and '$(CopperFsSfs2ExtraKiB)' != '64' and '$(CopperFsSfs2ExtraKiB)' != '256'" Text="SFS2 extra memory must be 0, 16, 64 or 256 KiB." />
  </Target>
  <Target Name="ValidateStandaloneProfile" BeforeTargets="BeforeBuild"
          Condition="'$(CopperStartSfsTrstBuffered)' == 'true'">
    <Error Condition="'$(CopperStartSfsTrstWrites)' != 'true' or '$(CopperStartSfsStrictWrites)' == 'true' or '$(CopperStartNativeSfs2)' == 'true'"
           Text="Buffered TRST requires a classic TRST handler without strict writes." />
  </Target>
  <Target Name="ValidateFfsOnlyProfile" BeforeTargets="BeforeBuild" Condition="'$(CopperFsFfsOnly)' == 'true' and '$(CopperStartNativeSfs2)' == 'true'">
    <Error Text="CopperFsFfsOnly cannot be combined with CopperStartNativeSfs2." />
  </Target>
  <Target Name="ValidateSmartOnlyProfile" BeforeTargets="BeforeBuild" Condition="'$(CopperFsSmartOnly)' == 'true' and '$(CopperFsFfsOnly)' == 'true'">
    <Error Text="CopperFsSmartOnly cannot be combined with CopperFsFfsOnly." />
  </Target>
  <ItemGroup Condition="'$(CopperFsHandler)' != 'Cpx4'">
    <InternalsVisibleTo Include="CopperFS.Kickstart.Tests" />
    <ProjectReference Include="../CopperSFS.Core/CopperSFS.Core.csproj" />
    <Using Include="CopperSFS" />
  </ItemGroup>
  <ItemGroup Condition="'$(CopperFsHandler)' == 'Cpx4'">
    <Compile Remove="**/*.cs" />
    <Compile Include="Cpx4/*.cs" />
    <ProjectReference Include="../CopperCPX.Core/CopperCPX.Core.csproj" />
    <ProjectReference Include="$(CopperSharp68kRoot)/Sdk.Amiga/CopperSharp.Sdk.Amiga.csproj" />
  </ItemGroup>
  <Import Project="../../build/CopperFFS.Sources.props" Condition="'$(CopperFsHandler)' != 'Cpx4'" />
</Project>
