<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopperScreenRoot Condition="'$(CopperScreenRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\CopperScreen</CopperScreenRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CopperSFS.Core\CopperSFS.Core.csproj" />
    <ProjectReference Include="$(CopperSharp68kRoot)\Targets.Amiga\CopperSharp.Targets.Amiga.csproj" />
    <ProjectReference Include="$(CopperSharp68kRoot)\Compiler.BootAdf\CopperSharp.Compiler.BootAdf.csproj" />
    <ProjectReference Include="$(CopperScreenRoot)\CopperMod.Amiga.Lightweight\CopperMod.Amiga.Lightweight.csproj" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
