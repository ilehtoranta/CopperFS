<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <IsPackable>false</IsPackable><IsTestProject>true</IsTestProject>
    <CopperStartRoot Condition="'$(CopperStartRoot)' == ''">$(MSBuildThisFileDirectory)../../../CopperStart</CopperStartRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Copper68k" Version="[1.5.4]" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/CopperFS.Amiga/CopperFS.Amiga.csproj" />
    <!-- Reuse CopperStart's MIT-licensed instruction replay bus in place;
         no copied fixture, ROM, media or OS implementation is embedded. -->
    <Compile Include="$(CopperStartRoot)/tests/CopperStart.Exec.Tests/NativeParityBus.cs" Link="NativeParityBus.cs" />
  </ItemGroup>
</Project>
