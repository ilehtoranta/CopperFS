<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <IsPackable>false</IsPackable><IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);COPPERSTART_FILESYSTEM_SEMANTIC_TESTS</DefineConstants>
    <DefineConstants Condition="'$(CopperFsAutoTrim)' == 'true'">$(DefineConstants);COPPERFS_AUTOTRIM</DefineConstants>
    <CopperScreenRoot Condition="'$(CopperScreenRoot)' == ''">$(MSBuildThisFileDirectory)../../../CopperScreen</CopperScreenRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native arithmetic probes compile these helpers into the guest assembly. -->
    <Compile Include="../../src/CopperFFS.Core/AmigaGeometryMath.cs" Link="Arithmetic/AmigaGeometryMath.cs" />
    <Compile Include="../../src/CopperSFS.Core/AmigaSfsGeometryMath.cs" Link="Arithmetic/AmigaSfsGeometryMath.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../tools/CopperSFS.Bench/CopperSFS.Bench.csproj" />
    <ProjectReference Include="../../src/CopperFS.Amiga/CopperFS.Amiga.csproj" />
    <ProjectReference Include="../../prototypes/CopperFS.Cpx4.Reference/CopperFS.Cpx4.Reference.csproj" />
    <ProjectReference Include="$(CopperSharp68kRoot)/Targets.Amiga/CopperSharp.Targets.Amiga.csproj" />
    <ProjectReference Include="$(CopperSharp68kRoot)/Compiler.BootAdf/CopperSharp.Compiler.BootAdf.csproj" />
    <ProjectReference Include="$(CopperScreenRoot)/CopperMod.Amiga.Lightweight/CopperMod.Amiga.Lightweight.csproj" />
    <!-- Original repository fixtures/checker; source-linked, with their provenance retained. -->
    <Compile Include="../CopperFFS.Core.Tests/DosDiskImage.cs" Link="Fixtures/DosDiskImage.cs" />
    <Compile Include="../../tools/CopperFS.StorageBench/StorageMatrixDefinition.cs" Link="StorageMatrixDefinition.cs" />
    <Compile Include="../../tools/CopperFS.StorageBench/StorageIdePartition.cs" Link="StorageIdePartition.cs" />
  </ItemGroup>
</Project>
